{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Ninja: pinetime-app",
            "type": "shell",
            "command": "ninja -j14 pinetime-app",
            "options": {
                "cwd": "${workspaceFolder}/build_vscode"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
